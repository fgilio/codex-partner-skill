{
  "name": "codex-token",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "CODEX_AUTH",
      "id": "e375ecfde5ba4c16a9583a4b04eb2531",
    },
  ],
  // Every 6 hours. The worker refreshes once the access token has
  // less than 36 hours left, so one failed run never strands clients.
  "triggers": {
    "crons": ["17 */6 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
